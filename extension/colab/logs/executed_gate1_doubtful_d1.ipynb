KAGE_ZIP)} -d /content\nelif not PROJECT_ROOT.exists():\n    raise FileNotFoundError(f"Upload {PACKAGE_ZIP.name} to Colab, then rerun this cell.")\n\nDATASET_CSV = PROJECT_ROOT / "data" / f"{RUN_NAME}_domains.csv"\nif not DATASET_CSV.exists():\n    raise FileNotFoundError(f"Missing {DATASET_CSV}")\nprint(DATASET_CSV, DATASET_CSV.stat().st_size, "bytes")'}, {'cell_type': 'code', 'execution_count': 4, 'id': 'a07fdcdc', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:17:58.412613Z', 'iopub.status.busy': '2026-10-19T16:17:58.412046Z', 'iopub.status.idle': '2026-10-19T16:18:03.115774Z', 'shell.execute_reply': '2026-10-19T16:18:03.114839Z'}, 'trusted': False}, 'outputs': [], 'source': '# Install only the selected decision model, pinned to a fixed revision.\nMODEL_REVISIONS = {\n    "julia": "a85b127321d580d65176c89ced8273f305745d85",\n    "laya": "7b928d828b7b0e022f929d9bd2e44165aa270148",\n    "d1": "051bcc464b01b9f92942b364d9586b0ef5912432"\n}\n\nif DECISION_MODEL == "julia":\n    from huggingface_hub import snapshot_download\n    snapshot_download("SupersonicLabs/Julia-1", local_dir="/content/Julia-1", revision=MODEL_REVISIONS["julia"])\n    %pip install -q -e /content/Julia-1\n    sys.path.insert(0, "/content/Julia-1")\nelif DECISION_MODEL == "laya":\n    %pip install -q laya\nelif DECISION_MODEL == "d1":\n    %pip install -q "transformers>=5.14"'}, {'cell_type': 'markdown', 'id': '2240af21', 'metadata': {}, 'source': '## 3. Configuration\n\nThe typed questions are fixed before any run. Both use two options with neutral keys `a` and `b`. The stored probabilities are those of the WL option (`WL_KEY`) and of the DGA option (`DGA_KEY`).'}, {'cell_type': 'code', 'execution_count': 5, 'id': '15b61bfa', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:18:03.119628Z', 'iopub.status.busy': '2026-10-19T16:18:03.119024Z', 'iopub.status.idle': '2026-10-19T16:18:03.128951Z', 'shell.execute_reply': '2026-10-19T16:18:03.128221Z'}, 'trusted': False}, 'outputs': [{'data': {'text/plain': "{'run_name': 'gate1_doubtful',\n 'decision_model': 'd1',\n 'dataset': '/content/New_Paper_MOE/data/gate1_doubtful_domains.csv',\n 'output': '/content/New_Paper_MOE/experiments/predictions/gate1_doubtful_d1_decision_predictions.csv'}"}, 'execution_count': 5, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'OUTPUT_DIR = PROJECT_ROOT / "experiments" / "predictions"\nOUTPUT_CSV = OUTPUT_DIR / f"{RUN_NAME}_{DECISION_MODEL}_decision_predictions.csv"\nRUN_METADATA_JSON = OUTPUT_DIR / f"{RUN_NAME}_{DECISION_MODEL}_runtime_metadata.json"\n\n# Option order chosen on the development smoke sample (400 gate1 domains): random/benign option first.\nQUESTIONS = {\n    "wl": {\n        "type": "choice",\n        "instructions": "Look only at the domain name. How is its main part built?",\n        "criteria": {"a": "Random-looking letters or digits", "b": "Real English words joined together"},\n    },\n    "dga": {\n        "type": "choice",\n        "instructions": "Look only at the domain name. Who most likely created it?",\n        "criteria": {"a": "A person or company, for a real website or service", "b": "Malware, using a domain generation algorithm"},\n    },\n}\nWL_KEY = "b"\nDGA_KEY = "b"\n\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n{"run_name": RUN_NAME, "decision_model": DECISION_MODEL, "dataset": str(DATASET_CSV), "output": str(OUTPUT_CSV)}'}, {'cell_type': 'markdown', 'id': 'bc3d4952', 'metadata': {}, 'source': '## 4. Load Dataset\n\nThe dataset must contain `domain`, `family`, `dga_type`, `split`, and `y_true`.'}, {'cell_type': 'code', 'execution_count': 6, 'id': 'd79cb0d4', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:18:03.132229Z', 'iopub.status.busy': '2026-10-19T16:18:03.131961Z', 'iopub.status.idle': '2026-10-19T16:18:03.200156Z', 'shell.execute_reply': '2026-10-19T16:18:03.199425Z'}, 'trusted': False}, 'outputs': [{'data': {'text/html': '\n  <div id="df-a4f0bd62-d729-4076-af10-8e7e04958a7