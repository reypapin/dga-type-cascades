   height: 32px;\n      padding: 0 0 0 0;\n      width: 32px;\n    }\n\n    .colab-df-convert:hover {\n      background-color: #E2EBFA;\n      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n      fill: #174EA6;\n    }\n\n    .colab-df-buttons div {\n      margin-bottom: 4px;\n    }\n\n    [theme=dark] .colab-df-convert {\n      background-color: #3B4455;\n      fill: #D2E3FC;\n    }\n\n    [theme=dark] .colab-df-convert:hover {\n      background-color: #434B5C;\n      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n      fill: #FFFFFF;\n    }\n  </style>\n\n    <script>\n      const buttonEl =\n        document.querySelector(\'#df-adba1916-34ac-4b83-9f72-e2f79c5e5f93 button.colab-df-convert\');\n      buttonEl.style.display =\n        google.colab.kernel.accessAllowed ? \'block\' : \'none\';\n\n      async function convertToInteractive(key) {\n        const element = document.querySelector(\'#df-adba1916-34ac-4b83-9f72-e2f79c5e5f93\');\n        const dataTable =\n          await google.colab.kernel.invokeFunction(\'convertToInteractive\',\n                                                    [key], {});\n        if (!dataTable) return;\n\n        const docLinkHtml = \'Like what you see? Visit the \' +\n          \'<a target="_blank" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>\'\n          + \' to learn more about interactive tables.\';\n        element.innerHTML = \'\';\n        dataTable[\'output_type\'] = \'display_data\';\n        await google.colab.output.renderOutput(dataTable, element);\n        const docLink = document.createElement(\'div\');\n        docLink.innerHTML = docLinkHtml;\n        element.appendChild(docLink);\n      }\n    </script>\n  </div>\n  \n    </div>\n  </div>\n  ', 'text/plain': '                 domain       family dga_type    split  y_true\n0  000212grahambel.info       benign   benign   benign       0\n1            0007ca.com       benign   benign   benign       0\n2        000ac556e3.com     enviserv       NW  heldout       1\n3             000da.com       benign   benign   benign       0\n4      000e0ffc7d47.com  pandabanker       NW  heldout       1'}, 'execution_count': 6, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'domains = pd.read_csv(DATASET_CSV)\nrequired = {"domain", "family", "dga_type", "split", "y_true"}\nmissing = required - set(domains.columns)\nif missing:\n    raise ValueError(f"Missing required columns: {sorted(missing)}")\ndomains["domain"] = domains["domain"].astype(str).str.strip().str.lower()\ndisplay(domains.groupby(["dga_type"]).size().rename("domains").reset_index())\ndomains.head()'}, {'cell_type': 'markdown', 'id': 'aa910d2e', 'metadata': {}, 'source': '## 5. Decision-Model Adapter\n\nEvery adapter answers both questions for one domain in a single call.'}, {'cell_type': 'code', 'execution_count': 7, 'id': '54a0b9e2', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:18:03.203846Z', 'iopub.status.busy': '2026-10-19T16:18:03.203538Z', 'iopub.status.idle': '2026-10-19T16:18:55.005458Z', 'shell.execute_reply': '2026-10-19T16:18:55.004527Z'}, 'trusted': False}, 'outputs': [{'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'f5060f0a198f46e9b724497d240fd0b8', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'Loading weights:   0%|          | 0/707 [00:00<?, ?it/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'name': 'stderr', 'output_type': 'stream', 'text': '/usr/local/lib/python3.13/dist-packages/huggingface_hub/utils/_auth.py:138: UserWarning: \nError while fetching `HF_TOKEN` secret value from your vault: \'Requesting secret HF_TOKEN timed out. Secrets can only be fetched when running from the Colab UI.\'.\n  warnings.warn(f"\\nError while fetching `HF_TOKEN` secret value from your vault: \'{str(e)}\'.")\nWarning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n'}, {'name': 'stderr', 'output_type': 'stream', 'text': 'WARNING:huggingface_hub.utils._http:Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n'}, {'data': {'text/plain': "{'wl': {'type': 'choice',\n  'choice': 'b',\n  'confidence': 0.786622824583395,\n  'probabilities': {'a': 0.21337717541660498, 'b': 0.786622824583395}},\n 'dga': {'type': 'choice',\n  'choice': 'a',\n  'confidence': 0.9717790128704671,\n  'probabilities': {'a': 0.9717790128704671, 'b': 0.02822098712953305}}}"}, 'execution_count': 7, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'import torch\n\ndevice = "cuda" if torch.cuda.is_available() else "cpu"\ndtype_used = "default"\n\n\ndef prob_of(answer: dict, key: str = "a") -> float:\n    if "probabilities" in answer:\n        return float(answer["probabilities"][key])\n    conf = float(answer["confidence"])\n    return conf if answer["choice"] == key else 1.0 - conf\n\n\ndef state_of(domain: str) -> str:\n    return f"Domain name: {domain}"\n\n\nif DECISION_MODEL == "julia":\n    from julia import load_model\n\n    engine = load_model("/content/Julia-1", device=device, strict_encoding=True, max_length=8192, head_length=512)\n\n    def ask(domain: str) -> dict:\n        return engine.predict(state=state_of(domain), questions=QUESTIONS)["answers"]\nelif DECISION_MODEL == "laya":\n    import laya\n\n    try:\n        agent = laya.load("convaiinnovations/laya", device=device)\n    except TypeError:\n        agent = laya.load("convaiinnovations/laya")\n\n    def ask(domain: str) -> dict:\n        return agent.predict(state_of(domain), QUESTIONS)["answers"]\nelif DECISION_MODEL == "d1":\n    from transformers import AutoModel\n\n    model = AutoModel.from_pretrained(\n        "LiquidAI/d1-3B", trust_remote_code=True, dtype=torch.float16, revision=MODEL_REVISIONS["d1"]\n    ).to(device).eval()\n    dtype_used = "float16"\n\n    def ask(domain: str) -> dict:\n        return model.system_one(state_of(domain), QUESTIONS)["answers"]\nelse:\n    raise ValueError(f"Unknown decision model {DECISION_MODEL}")\n\nask("example.com")'}, {'cell_type': 'markdown', 'id': '44b84442', 'metadata': {}, 'source': "## 6. Inference Helpers\n\nEach domain is one call that answers both questions. The time of that call is the domain's latency. Two warm-up rounds run first, as in the expert runs."}, {'cell_type': 'code', 'execution_count': 8, 'id': '1795eda0', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:18:55.009590Z', 'iopub.status.busy': '2026-10-19T16:18:55.008715Z', 'iopub.status.idle': '2026-10-19T16:18:55.016161Z', 'shell.execute_reply': '2026-10-19T16:18:55.015384Z'}, 'trusted': False}, 'outputs': [], 'source': 'def run_decision_model(frame: pd.DataFrame) -> pd.DataFrame:\n    domains_list = frame["domain"].tolist()\n    for _ in range(2):\n        for domain in domains_list[:8]:\n            ask(domain)\n    p_wl = np.empty(len(domains_list), dtype=float)\n    p_dga = np.empty(len(domains_list), dtype=float)\n    latency_ms = np.empty(len(domains_list), dtype=float)\n    for i, domain in enumerate(domains_list):\n        t0 = time.perf_counter()\n        answers = ask(domain)\n        latency_ms[i] = (time.perf_counter() - t0) * 1000.0\n        p_wl[i] = prob_of(answers["wl"], WL_KEY)\n        p_dga[i] = prob_of(answers["dga"], DGA_KEY)\n        if i % 5000 == 0:\n            print(i, "of", len(domains_list), flush=True)\n    out = frame.copy()\n    out["model"] = DECISION_MODEL\n    out["p_wl"] = p_wl\n    out["p_dga"] = p_dga\n    out["latency_ms"] = latency_ms\n    return out'}, {'cell_type': 'markdown', 'id': 'f5e1fdc9', 'metadata': {}, 'source': '## 7. Run Decision Model'}, {'cell_type': 'code', 'execution_count': 9, 'id': '888c3385', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:18:55.019511Z', 'iopub.status.busy': '2026-10-19T16:18:55.019202Z', 'iopub.status.idle': '2026-10-19T16:51:22.998505Z', 'shell.execute_reply': '2026-10-19T16:51:22.997315Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '0 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '5000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '10000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '15000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '20000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '25000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '30000 of 36462\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '35000 of 36462\n'}, {'data': {'text/html': '\n  <div id="df-e2fabc78-2013-4743-a91b-5f16990f116d" class="colab-df-container">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border="1" class="dataframe">\n  <thead>\n    <tr style="text-align: right;">\n      <th></th>\n      <th>p_wl</th>\n      <th>p_dga</th>\n      <th>latency_ms</th>\n    </tr>\n    <tr>\n      <th>dga_type</th>\n      <th></th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>NW</th>\n      <td>0.165600</td>\n      <td>0.285519</td>\n      <td>53.385678</td>\n    </tr>\n    <tr>\n      <th>WL</th>\n      <td>0.708080</td>\n      <td>0.173676</td>\n      <td>53.492924</td>\n    </tr>\n    <tr>\n      <th>benign</th>\n      <td>0.659591</td>\n      <td>0.098340</td>\n      <td>53.353858</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n    <div class="colab-df-buttons">\n      \n  <div class="colab-df-container">\n    <button class="colab-df-convert" onclick="convertToInteractive(\'df-e2fabc78-2013-4743-a91b-5f16990f116d\')"\n        