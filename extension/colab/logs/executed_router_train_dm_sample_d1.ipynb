lication/vnd.jupyter.widget-view+json': {'model_id': 'e7d4a1c4538f45bdb1fd75adbf0ff305', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'model.safetensors: reconstructing file:   0%|          |  0.00B / 6.25GB            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '44d0af74f95445b88dc98ee2959d25a4', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'model.safetensors: downloading bytes:           |  0.00B            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '570502ae6aa34694a1287073a97b0ce6', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'Loading weights:   0%|          | 0/707 [00:00<?, ?it/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '73b1799e3bd44454963ac87679f2b750', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer_config.json:   0%|          | 0.00/507 [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'e439316518eb49aa8b509f8e17d09768', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.json: reconstructing file:   0%|          |  0.00B / 17.9MB            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '333f82a476194882aa5d7779563ab9db', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.json: downloading bytes:           |  0.00B            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'ab97478938974d21a3120d3bd3ef94a8', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'chat_template.jinja:   0%|          | 0.00/5.44k [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'text/plain': "{'wl': {'type': 'choice',\n  'choice': 'b',\n  'confidence': 0.786622824583395,\n  'probabilities': {'a': 0.21337717541660498, 'b': 0.786622824583395}},\n 'dga': {'type': 'choice',\n  'choice': 'a',\n  'confidence': 0.9717790128704671,\n  'probabilities': {'a': 0.9717790128704671, 'b': 0.02822098712953305}}}"}, 'execution_count': 7, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'import torch\n\ndevice = "cuda" if torch.cuda.is_available() else "cpu"\ndtype_used = "default"\n\n\ndef prob_of(answer: dict, key: str = "a") -> float:\n    if "probabilities" in answer:\n        return float(answer["probabilities"][key])\n    conf = float(answer["confidence"])\n    return conf if answer["choice"] == key else 1.0 - conf\n\n\ndef state_of(domain: str) -> str:\n    return f"Domain name: {domain}"\n\n\nif DECISION_MODEL == "julia":\n    from julia import load_model\n\n    engine = load_model("/content/Julia-1", device=device, strict_encoding=True, max_length=8192, head_length=512)\n\n    def ask(domain: str) -> dict:\n        return engine.predict(state=state_of(domain), questions=QUESTIONS)["answers"]\nelif DECISION_MODEL == "laya":\n    import laya\n\n    try:\n        agent = laya.load("convaiinnovations/laya", device=device)\n    except TypeError:\n        agent = laya.load("convaiinnovations/laya")\n\n    def ask(domain: str) -> dict:\n        return agent.predict(state_of(domain), QUESTIONS)["answers"]\nelif DECISION_MODEL == "d1":\n    from transformers import AutoModel\n\n    model = AutoModel.from_pretrained(\n        "LiquidAI/d1-3B", trust_remote_code=True, dtype=torch.float16, revision=MODEL_REVISIONS["d1"]\n    ).to(device).eval()\n    dtype_used = "float16"\n\n    def ask(domain: str) -> dict:\n        return model.system_one(state_of(domain), QUESTIONS)["answers"]\nelse:\n    raise ValueError(f"Unknown decision model {DECISION_MODEL}")\n\nask("example.com")'}, {'cell_type': 'markdown', 'id': '242e561f', 'metadata': {}, 'source': "## 6. Inference Helpers\n\nEach domain is one call that answers both questions. The time of that call is the domain's latency. Two warm-up rounds run first, as in the expert runs."}, {'cell_type': 'code', 'execution_count': 8, 'id': '5dc7d9ea', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:10:34.098419Z', 'iopub.status.busy': '2026-10-19T16:10:34.097898Z', 'iopub.status.idle': '2026-10-19T16:10:34.104936Z', 'shell.execute_reply': '2026-10-19T16:10:34.104198Z'}, 'trusted': False}, 'outputs': [], 'source': 'def run_decision_model(frame: pd.DataFrame) -> pd.DataFrame:\n    domains_list = frame["domain"].tolist()\n    for _ in range(2):\n        for domain in domains_list[:8]:\n            ask(domain)\n    p_wl = np.empty(len(domains_list), dtype=float)\n    p_dga = np.empty(len(domains_list), dtype=float)\n    latency_ms = np.empty(len(domains_list), dtype=float)\n    for i, domain in enumerate(domains_list):\n        t0 = time.perf_counter()\n        answers = ask(domain)\n        latency_ms[i] = (time.perf_counter() - t0) * 1000.0\n        p_wl[i] = prob_of(answers["wl"], WL_KEY)\n        p_dga[i] = prob_of(answers["dga"], DGA_KEY)\n        if i % 5000 == 0:\n            print(i, "of", len(domains_list), flush=True)\n    out = frame.copy()\n    out["model"] = DECISION_MODEL\n    out["p_wl"] = p_wl\n    out["p_dga"] = p_dga\n    out["latency_ms"] = latency_ms\n    return out'}, {'cell_type': 'markdown', 'id': '2096c246', 'metadata': {}, 'source': '## 7. Run Decision Model'}, {'cell_type': 'code', 'execution_count': 9, 'id': 'dd35ab79', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:10:34.108052Z', 'iopub.status.busy': '2026-10-19T16:10:34.107773Z', 'iopub.status.idle': '2026-10-19T16:17:38.843987Z', 'shell.execute_reply': '2026-10-19T16:17:38.843244Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '0 of 8000\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '5000 of 8000\n'}, {'data': {'text/html': '\n  <div id="df-b5c0ecb4-df28-4fa7