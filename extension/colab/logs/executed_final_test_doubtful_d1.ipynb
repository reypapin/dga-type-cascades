r(PACKAGE_ZIP)} -d /content\nelif not PROJECT_ROOT.exists():\n    raise FileNotFoundError(f"Upload {PACKAGE_ZIP.name} to Colab, then rerun this cell.")\n\nDATASET_CSV = PROJECT_ROOT / "data" / f"{RUN_NAME}_domains.csv"\nif not DATASET_CSV.exists():\n    raise FileNotFoundError(f"Missing {DATASET_CSV}")\nprint(DATASET_CSV, DATASET_CSV.stat().st_size, "bytes")'}, {'cell_type': 'code', 'execution_count': 4, 'id': 'fb8844a2', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:57:48.570411Z', 'iopub.status.busy': '2026-10-19T16:57:48.569698Z', 'iopub.status.idle': '2026-10-19T16:57:54.983314Z', 'shell.execute_reply': '2026-10-19T16:57:54.982580Z'}, 'trusted': False}, 'outputs': [], 'source': '# Install only the selected decision model, pinned to a fixed revision.\nMODEL_REVISIONS = {\n    "julia": "a85b127321d580d65176c89ced8273f305745d85",\n    "laya": "7b928d828b7b0e022f929d9bd2e44165aa270148",\n    "d1": "051bcc464b01b9f92942b364d9586b0ef5912432"\n}\n\nif DECISION_MODEL == "julia":\n    from huggingface_hub import snapshot_download\n    snapshot_download("SupersonicLabs/Julia-1", local_dir="/content/Julia-1", revision=MODEL_REVISIONS["julia"])\n    %pip install -q -e /content/Julia-1\n    sys.path.insert(0, "/content/Julia-1")\nelif DECISION_MODEL == "laya":\n    %pip install -q laya\nelif DECISION_MODEL == "d1":\n    %pip install -q "transformers>=5.14"'}, {'cell_type': 'markdown', 'id': '0c1b62d9', 'metadata': {}, 'source': '## 3. Configuration\n\nThe typed questions are fixed before any run. Both use two options with neutral keys `a` and `b`. The stored probabilities are those of the WL option (`WL_KEY`) and of the DGA option (`DGA_KEY`).'}, {'cell_type': 'code', 'execution_count': 5, 'id': '916d93da', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:57:54.987009Z', 'iopub.status.busy': '2026-10-19T16:57:54.986212Z', 'iopub.status.idle': '2026-10-19T16:57:54.995418Z', 'shell.execute_reply': '2026-10-19T16:57:54.994711Z'}, 'trusted': Fa