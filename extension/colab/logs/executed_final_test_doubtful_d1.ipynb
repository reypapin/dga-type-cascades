 'version_minor': 0}, 'text/plain': 'model.safetensors: reconstructing file:   0%|          |  0.00B / 6.25GB            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '3ec411fbeeaa4132b8ccf1e90582a058', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'model.safetensors: downloading bytes:           |  0.00B            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '5fed1711a6404423b86ba20d0572b890', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'Loading weights:   0%|          | 0/707 [00:00<?, ?it/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '39060225b0ec48d2b8dc6057e77c1f2f', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer_config.json:   0%|          | 0.00/507 [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'efa16504ea0e44c59350a8eb7b32d181', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.json: reconstructing file:   0%|          |  0.00B / 17.9MB            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'be6c48cf7f914987bbd58d1484210cb3', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.json: downloading bytes:           |  0.00B            '}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '1ca319d0055f49bf879e14ffd325a5b0', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'chat_template.jinja:   0%|          | 0.00/5.44k [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'text/plain': "{'wl': {'type': 'choice',\n  'choice': 'b',\n  'confidence': 0.786622824583395,\n  'probabilities': {'a': 0.21337717541660498, 'b': 0.786622824583395}},\n 'dga': {'type': 'choice',\n  'choice': 'a',\n  'confidence': 0.9717790128704671,\n  'probabilities': {'a': 0.9717790128704671, 'b': 0.02822098712953305}}}"}, 'execution_count': 7, 'metadata': {}, 'output_type': 'execute_result'}], 'source': 'import torch\n\ndevice = "cuda" if torch.cuda.is_available() else "cpu"\ndtype_used = "default"\n\n\ndef prob_of(answer: dict, key: str = "a") -> float:\n    if "probabilities" in answer:\n        return float(answer["probabilities"][key])\n    conf = float(answer["confidence"])\n    return conf if answer["choice"] == key else 1.0 - conf\n\n\ndef state_of(domain: str) -> str:\n    return f"Domain name: {domain}"\n\n\nif DECISION_MODEL == "julia":\n    from julia import load_model\n\n    engine = load_model("/content/Julia-1", device=device, strict_encoding=True, max_length=8192, head_length=512)\n\n    def ask(domain: str) -> dict:\n        return engine.predict(state=state_of(domain), questions=QUESTIONS)["answers"]\nelif DECISION_MODEL == "laya":\n    import laya\n\n    try:\n        agent = laya.load("convaiinnovations/laya", device=device)\n    except TypeError:\n        agent = laya.load("convaiinnovations/laya")\n\n    def ask(domain: str) -> dict:\n        return agent.predict(state_of(domain), QUESTIONS)["answers"]\nelif DECISION_MODEL == "d1":\n    from transformers import AutoModel\n\n    model = AutoModel.from_pretrained(\n        "LiquidAI/d1-3B", trust_remote_code=True, dtype=torch.float16, revision=MODEL_REVISIONS["d1"]\n    ).to(device).eval()\n    dtype_used = "float16"\n\n    def ask(domain: str) -> dict:\n        return model.system_one(state_of(domain), QUESTIONS)["answers"]\nelse:\n    raise ValueError(f"Unknown decision model {DECISION_MODEL}")\n\nask("example.com")'}, {'cell_type': 'markdown', 'id': '466704ef', 'metadata': {}, 'source': "## 6. Inference Helpers\n\nEach domain is one call that answers both questions. The time of that call is the domain's latency. Two warm-up rounds run first, as in the expert runs."}, {'cell_type': 'code', 'execution_count': 8, 'id': '276ae98f', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:59:44.715279Z', 'iopub.status.busy': '2026-10-19T16:59:44.714721Z', 'iopub.status.idle': '2026-10-19T16:59:44.723969Z', 'shell.execute_reply': '2026-10-19T16:59:44.723447Z'}, 'trusted': False}, 'outputs': [], 'source': 'def run_decision_model(frame: pd.DataFrame) -> pd.DataFrame:\n    domains_list = frame["domain"].tolist()\n    for _ in range(2):\n        for domain in domains_list[:8]:\n            ask(domain)\n    p_wl = np.empty(len(domains_list), dtype=float)\n    p_dga = np.empty(len(domains_list), dtype=float)\n    latency_ms = np.empty(len(domains_list), dtype=float)\n    for i, domain in enumerate(domains_list):\n        t0 = time.perf_counter()\n        answers = ask(domain)\n        latency_ms[i] = (time.perf_counter() - t0) * 1000.0\n        p_wl[i] = prob_of(answers["wl"], WL_KEY)\n        p_dga[i] = prob_of(answers["dga"], DGA_KEY)\n        if i % 5000 == 0:\n            print(i, "of", len(domains_list), flush=True)\n    out = frame.copy()\n    out["model"] = DECISION_MODEL\n    out["p_wl"] = p_wl\n    out["p_dga"] = p_dga\n    out["latency_ms"] = latency_ms\n    return out'}, {'cell_type': 'markdown', 'id': 'f0f79765', 'metadata': {}, 'source': '## 7. Run Decision Model'}, {'cell_type': 'code', 'execution_count': 9, 'id': 'ddf2d9fc', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T16:59:44.727164Z', 'iopub.status.busy': '2026-10-19T16:59:44.726853Z', 'iopub.status.idle': '2026-10-19T17:27:33.342161Z', 'shell.execute_reply': '2026-10-19T17:27:33.341415Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '0 of 29800\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '5000 of 29800\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '10000 of 29800\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '15000 of 29800\n'}, {'name': 'stdout',