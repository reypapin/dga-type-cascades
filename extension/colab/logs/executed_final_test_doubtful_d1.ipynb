y_ms\ndga_type                                \nNW        0.238269  0.283348   55.994962\nWL        0.712692  0.164728   56.188139\nbenign    0.630209  0.110820   55.826732'}, 'metadata': {}, 'output_type': 'display_data'}], 'source': 'predictions = run_decision_model(domains)\ndisplay(predictions.groupby("dga_type")[["p_wl", "p_dga", "latency_ms"]].mean())'}, {'cell_type': 'markdown', 'id': 'b36b83f9', 'metadata': {}, 'source': '## 8. Sanity Checks\n\nThese checks must pass before using the file.'}, {'cell_type': 'code', 'execution_count': 10, 'id': '8f135ece', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T17:27:33.345987Z', 'iopub.status.busy': '2026-10-19T17:27:33.345599Z', 'iopub.status.idle': '2026-10-19T17:27:33.364636Z', 'shell.execute_reply': '2026-10-19T17:27:33.363835Z'}, 'trusted': False}, 'outputs': [], 'source': 'if len(predictions) != len(domains):\n    raise ValueError(f"Expected {len(domains)} rows, got {len(predictions)}")\nif predictions.duplicated(subset=["domain", "family", "split"]).any():\n    raise ValueError("Duplicated domain/family/split rows found")\nfor col in ("p_wl", "p_dga"):\n    if predictions[col].isna().any() or not predictions[col].between(0, 1).all():\n        raise ValueError(f"{col} must be a probability")\nif (predictions["latency_ms"] < 0).any():\n    raise ValueError("Negative latency found")'}, {'cell_type': 'markdown', 'id': '685a4344', 'metadata': {}, 'source': '## 9. Export\n\nSave the prediction table and metadata. Bring these files back into the repository under `experiments/predictions/`.'}, {'cell_type': 'code', 'execution_count': 11, 'id': '3b1dc62e', 'metadata': {'execution': {'iopub.execute_input': '2026-10-19T17:27:33.367893Z', 'iopub.status.busy': '2026-10-19T17:27:33.367617Z', 'iopub.status.idle': '2026-10-19T17:27:33.648573Z', 'shell.execute_reply': '2026-10-19T17:27:33.647820Z'}, 'trusted': False}, 'outputs': [{'data': {'text/plain': "('/content/New_Paper_MOE/experiments/predictions/final_test